# -----------------------------------
# smarter-python Environment Variables
#
# The SDK reads the SMARTER_* variables: see smarter/common/conf.py.
# Without SMARTER_BASE_URL, the platform's url is derived from
# SMARTER_ENVIRONMENT (local, alpha, beta, next or prod) and
# SMARTER_ROOT_DOMAIN, as the smarter cli derives it.
#
# PYTHONPATH must be the repository root, never ./smarter: the
# package's own directory on the path would shadow the standard
# library's modules.
# -----------------------------------

################################################################
# Senstitve Information
################################################################
SMARTER_API_KEY=SET-ME-PLEASE
GH_TOKEN=SET-ME-PLEASE

################################################################
# Non-Sensitive Information
################################################################
SMARTER_ENVIRONMENT=prod
SMARTER_ROOT_DOMAIN=platform.smarter.sh
# SMARTER_BASE_URL=http://localhost:9357
# SMARTER_LOG=info
PYTHONPATH=.

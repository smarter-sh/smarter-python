{
  "apiVersion": "smarter.sh/v1",
  "kind": "WebsearchPlugin",
  "metadata": {
    "name": "research_assistant",
    "description": "Researches any topic on the open web, and cites its sources.",
    "version": "0.1.0",
    "tags": [
      "websearch",
      "research"
    ],
    "annotations": [
      {
        "smarter.sh/created_by": "smarter_websearch_plugin_broker"
      },
      {
        "smarter.sh/plugin": "research_assistant"
      }
    ],
    "pluginClass": "websearch"
  },
  "spec": {
    "selector": {
      "directive": "search_terms",
      "searchTerms": [
        "search the web",
        "look up",
        "latest",
        "news",
        "research"
      ]
    },
    "prompt": {
      "provider": "openai",
      "systemRole": "You are a careful research assistant. Search the web, read the most relevant pages, and cite your sources.",
      "model": "gpt-6-luna",
      "temperature": 1.0,
      "maxTokens": 2048
    },
    "websearchData": {
      "search": {
        "provider": "brave",
        "apiKey": "brave_search_api_key",
        "maxResults": 5,
        "safeSearch": "moderate",
        "country": null,
        "language": null,
        "freshness": null
      },
      "fetch": {
        "maxCharacters": 20000,
        "respectRobotsTxt": true
      },
      "allowedDomains": null,
      "blockedDomains": [
        "pinterest.com"
      ],
      "timeout": 15,
      "cacheTtl": 3600
    }
  },
  "status": {
    "recordLocator": "abc123def456",
    "created": "2024-01-01T00:00:00",
    "modified": "2024-01-01T00:00:00",
    "dependencies": null,
    "accountNumber": "1234567890",
    "username": "example_user"
  }
}
